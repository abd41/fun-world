# Copy to .env — or just run ./scripts/setup, which writes it for you.
# .env is gitignored and never committed.

# --- the one address in the project ----------------------------------------
# Resolved by scripts/setup in this order, FIRST MATCH WINS:
#   1. FW_HOST already in your environment
#   2. FW_HOST in this file        <- a value you set is NEVER overwritten
#   3. auto-detected LAN IPv4      <- convenience default only
#
# It is a HOST, not an IP. Nothing parses it or validates octets, so all of
# these are valid — which is what makes moving to a VPN a one-line change:
#
#   FW_HOST=192.168.0.106                 LAN address (changes with DHCP)
#   FW_HOST=funworld.local                mDNS (Android support is patchy)
#   FW_HOST=funworld.tailnet.ts.net       Tailscale — the recommended end state
#
# Pinning it removes the DHCP failure entirely: leave it auto-detected and your
# phone stops working whenever the router reassigns this machine's address.
FW_HOST=

# --- django -----------------------------------------------------------------
# No default anywhere in settings.py. A missing key stops the process rather
# than falling back to something predictable that then reaches a shared branch.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DATABASE_URL=postgres://funworld:funworld-dev@localhost:5433/funworld

# --- no third-party telemetry (constitution §6) -----------------------------
NEXT_TELEMETRY_DISABLED=1
