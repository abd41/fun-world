{
  "name": "@fun-world/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ./scripts/expo.cjs start",
    "android": "node ./scripts/expo.cjs start --android",
    "ios": "node ./scripts/expo.cjs start --ios",
    "typecheck": "tsc --noEmit",
    "bundle:android": "node ./scripts/expo.cjs export --platform android --output-dir dist"
  },
  "dependencies": {
    "@fun-world/contracts": "workspace:*",
    "expo": "~57.0.17",
    "expo-constants": "~57.0.15",
    "expo-linking": "~57.0.8",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/node": "~22.15.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
